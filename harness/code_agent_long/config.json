{
  "name": "code_agent_long",
  "display_name": "Code Agent · Long / Evolving",
  "description": "Evidence-shaped long-horizon coding Agent. It combines capability search, durable workspace memory, passive context compaction, tool-output pruning and governed reusable-skill evolution. Periodic curation and delegation stay off because matched experiments found no default efficiency gain; use Code Agent · Team when isolation is the goal.",
  "tags": ["product", "code", "long-horizon", "adaptive", "user-facing"],
  "catalog": {"category": "system", "visibility": "public", "display_name": "Code Agent · Long / Evolving"},
  "component": {
    "name": "code_agent_long",
    "display_name": "Code Agent · Long / Evolving",
    "category": "Agent",
    "icon": "∞",
    "description": "Long-context engineering with verified reusable-skill evolution and evidence-backed context controls.",
    "share_session": true,
    "inputs": {},
    "outputs": {
      "answer": {"path": "answer", "default": ""},
      "profile": {"path": "profile", "default": "long"},
      "evolved": {"path": "evolved", "default": false},
      "context_stats": {"path": "context_stats", "default": {}},
      "reviews": {"path": "reviews", "default": []}
    }
  },
  "slots": {
    "agent": {"description": "Primary adaptive software engineer", "required": true, "identity": "adaptive_deepseek_coder"},
    "governor": {"description": "Planner, context governor and evolver", "required": true, "identity": "adaptive_deepseek_coder"},
    "quality_reviewer": {"description": "Independent correctness reviewer", "required": true, "identity": "deepseek_operator"},
    "safety_reviewer": {"description": "Independent scope and safety reviewer", "required": true, "identity": "deepseek_operator"}
  },
  "prompts": {},
  "return_mode": "last",
  "pipeline": {
    "start": "run_long",
    "max_steps": 580,
    "max_node_steps": 3400,
    "timeout_seconds": 7200,
    "workspace_preview": true,
    "interactive_max_tokens": null,
    "budget": {"max_model_calls": 300, "max_tool_calls": 960, "max_tokens": 2000000},
    "context": {"answer": "", "profile": "long", "evolved": false, "context_stats": {}, "reviews": []},
    "nodes": {
      "run_long": {
        "id": "run_long",
        "op": "子流程",
        "harness": "product_adaptive_code_agent",
        "share_session": true,
        "agent_map": {"agent": "agent", "governor": "governor", "quality_reviewer": "quality_reviewer", "safety_reviewer": "safety_reviewer"},
        "component_inputs": {
          "enable_evolution": true,
          "enable_delegation": false,
          "enable_memory": true,
          "enable_curation": false,
          "enable_compaction": true,
          "enable_tool_pruning": true
        },
        "component_outputs": {"answer": "answer", "evolved": "evolved", "context_stats": "context_stats", "reviews": "reviews"},
        "result_mode": "data",
        "output_var": "adaptive_result",
        "edges": [{"condition": "subflow_done", "to": "done"}]
      },
      "done": {"id": "done", "op": "结束", "value": {"answer": "$ctx.answer", "profile": "long", "evolved": "$ctx.evolved", "context": "$ctx.context_stats", "reviews": "$ctx.reviews"}, "edges": []}
    }
  }
}
