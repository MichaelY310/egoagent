{
  "name": "product_adaptive_pressure_no_context",
  "description": "Matched low-window pressure profile with periodic curation and passive compaction disabled; used only for context-governance parity experiments.",
  "tags": ["experiment", "code", "context", "ablation", "no-context-governance"],
  "slots": {
    "agent": {"description": "Primary adaptive software engineer", "required": true, "identity": "adaptive_deepseek_coder"},
    "governor": {"description": "Planner", "required": true, "identity": "adaptive_deepseek_coder"},
    "quality_reviewer": {"description": "Independent correctness reviewer", "required": true, "identity": "deepseek_operator"},
    "safety_reviewer": {"description": "Independent scope and safety reviewer", "required": true, "identity": "deepseek_operator"}
  },
  "prompts": {},
  "return_mode": "last",
  "pipeline": {
    "start": "run_pressure_without_context",
    "max_steps": 580,
    "max_node_steps": 3400,
    "timeout_seconds": 7200,
    "workspace_preview": true,
    "interactive_max_tokens": null,
    "budget": {"max_model_calls": 300, "max_tool_calls": 960, "max_tokens": 2000000},
    "context": {"result": {}},
    "nodes": {
      "run_pressure_without_context": {
        "id": "run_pressure_without_context",
        "op": "子流程",
        "harness": "product_adaptive_code_agent",
        "share_session": true,
        "agent_map": {"agent": "agent", "governor": "governor", "quality_reviewer": "quality_reviewer", "safety_reviewer": "safety_reviewer"},
        "component_inputs": {"enable_evolution": false, "enable_delegation": false, "enable_curation": false, "enable_compaction": false, "enable_tool_pruning": false, "curation_interval": 4, "curation_minimum_tokens": 8000, "evolution_interval": 6, "context_limit_tokens": 24576, "context_high_watermark": 0.7, "context_target_ratio": 0.5, "context_minimum_savings_tokens": 512},
        "component_outputs": {"answer": "answer", "evolved": "evolved", "context_stats": "context_stats", "reviews": "reviews"},
        "result_mode": "data",
        "output_var": "result",
        "edges": [{"condition": "subflow_done", "to": "done"}]
      },
      "done": {"id": "done", "op": "结束", "value": {"answer": "$ctx.answer", "evolved": "$ctx.evolved", "context": "$ctx.context_stats", "reviews": "$ctx.reviews"}, "edges": []}
    }
  }
}
