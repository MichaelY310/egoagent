{
    "type": "function",
    "title": "Multi Edit",
    "name": "multi_edit",
    "description": "Perform multiple string replacements in a single file. Each edit specifies an old_string to find and a new_string to replace it with. Edits are applied sequentially.",
    "parameters": {
        "type": "object",
        "properties": {
            "file_path": {
                "description": "The absolute path to the file to edit.",
                "type": "string"
            },
            "edits": {
                "description": "Array of edit operations. Each has 'old_string' and 'new_string'.",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "old_string": {"type": "string", "description": "The exact string to find."},
                        "new_string": {"type": "string", "description": "The string to replace with."}
                    },
                    "required": ["old_string", "new_string"]
                }
            }
        },
        "required": ["file_path", "edits"]
    },
    "tags": ["file", "edit", "batch"],
    "author": "admin",
    "created_at": "2025-06-08",
    "updated_at": "2025-06-08",
    "relations": [],
    "metadata": {"views": null, "likes": null, "comments": null},
    "embedding": null
}
