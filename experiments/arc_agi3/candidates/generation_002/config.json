{
  "name": "arc_long_horizon_candidate_g002",
  "description": "AVO-inspired general long-horizon solver for official ARC-AGI-3 environments: exact text interface, persistent evidence memory, bounded action loop, passive compaction and a non-acting stagnation supervisor.",
  "slots": {
    "explorer": {
      "description": "Main acting model",
      "required": true,
      "identity": "arc_explorer"
    },
    "supervisor": {
      "description": "Non-acting trajectory reviewer",
      "required": true,
      "identity": "arc_supervisor"
    },
    "compactor": {
      "description": "Pressure-triggered conversation compactor",
      "required": true,
      "identity": "arc_supervisor"
    }
  },
  "prompts": {
    "supervise": {
      "description": "General stagnation diagnosis; deliberately contains no game-specific rules",
      "default": "Review this unknown-environment trajectory as a non-acting supervisor. Separate direct observations from assumptions. Identify stagnation, repeated states, failed predictions, premature commitment, or unexplored action classes. Recommend 2-4 qualitatively different falsifiable experiments, ordered by information gain per action. Do not claim to know the game and do not choose the final action.\n\nRecent trajectory:\n{trajectory}\n\nPersistent prior learnings:\n{memory}\n\nReturn ONLY JSON: {{\"text\":\"compact durable diagnosis and intervention\",\"type\":\"supervision\",\"importance\":8,\"keywords\":[\"mechanic\",\"stagnation\"],\"evidence\":[\"specific observed transition\"]}}"
    }
  },
  "return_mode": "last",
  "pipeline": {
    "start": "input",
    "mode": "agent",
    "max_steps": 1200,
    "max_node_steps": 5000,
    "timeout_seconds": 14400,
    "workspace_preview": false,
    "permissions": {
      "defaults": {
        "network": "allow",
        "read": "allow",
        "write": "allow",
        "process": "deny",
        "mutation": "deny",
        "secret": "deny"
      }
    },
    "budget_exceeded_to": "budget_finish",
    "limit_finalizer_max_steps": 4,
    "budget": {
      "max_model_calls": 420,
      "max_tool_calls": 260,
      "max_tokens": 1800000
    },
    "context": {
      "request": "",
      "action_batches": 0,
      "supervision": {},
      "arc_memory": [],
      "compaction_stats": {}
    },
    "nodes": {
      "input": {
        "id": "input",
        "op": "输入",
        "outputs": {
          "text": "request"
        },
        "edges": [
          {
            "condition": "input",
            "to": "memory"
          }
        ]
      },
      "memory": {
        "id": "memory",
        "op": "记忆",
        "action": "list",
        "namespace": "arc_agi3_mechanics",
        "top_k": 12,
        "output_var": "arc_memory",
        "edges": [
          {
            "condition": "default",
            "to": "compact"
          }
        ]
      },
      "compact": {
        "id": "compact",
        "op": "子流程",
        "harness": "component_context_compactor",
        "share_session": true,
        "agent_map": {
          "compactor": "compactor"
        },
        "component_inputs": {
          "context_limit_tokens": 120000,
          "high_watermark": 0.78,
          "target_ratio": 0.56,
          "reserved_output_tokens": 8000,
          "protect_recent_turns": 3
        },
        "component_outputs": {
          "stats": "compaction_stats"
        },
        "result_mode": "data",
        "output_var": "compaction_result",
        "edges": [
          {
            "condition": "subflow_done",
            "to": "working_context"
          }
        ]
      },
      "working_context": {
        "id": "working_context",
        "op": "上下文",
        "action": "select",
        "source": "$session.messages",
        "last_n": 4,
        "max_chars": 36000,
        "output_var": "working_messages",
        "edges": [
          {
            "condition": "context_ready",
            "to": "act"
          }
        ]
      },
      "act": {
        "id": "act",
        "op": "Agent",
        "agent": "explorer",
        "tools": "all",
        "visible_tools": [
          "arc_start",
          "arc_act",
          "arc_status",
          "arc_finish"
        ],
        "max_tool_rounds": 260,
        "max_tool_calls_per_turn": 1,
        "max_tokens": 2200,
        "inputs": {
          "messages": "$ctx.working_messages"
        },
        "instructions": "Original task: ${ctx.request}\nRun the requested official ARC-AGI-3 game without hidden domain knowledge. Durable evidence: ${ctx.arc_memory}\nLatest supervisor intervention: ${ctx.supervision}\nMaintain a compact belief state: OBSERVED facts, UNCONFIRMED hypotheses, the last prediction and whether it held, then one highest-information next action. Do not narrate the entire grid or repeat old reasoning. Keep non-tool text under 220 words. Take exactly one environment action per model step so every decision observes its consequence. Call arc_finish when the run ends.",
        "retry": {
          "max_attempts": 3,
          "delay_seconds": 1,
          "backoff": 2
        },
        "timeout_seconds": 240,
        "edges": [
          {
            "condition": "has_tool_calls",
            "to": "permissions"
          },
          {
            "condition": "has_text",
            "to": "working_context"
          },
          {
            "condition": "stuck",
            "to": "supervisor_context"
          }
        ]
      },
      "permissions": {
        "id": "permissions",
        "op": "工具审查",
        "agent": "explorer",
        "review_mode": "policy",
        "default_permission": "deny",
        "policies": [
          {
            "tool": "arc_*",
            "permission": "allow"
          }
        ],
        "edges": [
          {
            "condition": "default",
            "to": "tools"
          }
        ]
      },
      "tools": {
        "id": "tools",
        "op": "工具",
        "agent": "explorer",
        "parallel": false,
        "truncate_after_tools": [
          "arc_finish"
        ],
        "terminal_tools_to": "result",
        "stuck_threshold": 3,
        "error_stuck_threshold": 3,
        "stuck_prompt": "The trajectory is repeating. Stop defending the current theory; list the contradicted assumption and test a qualitatively different mechanism.",
        "edges": [
          {
            "condition": "stuck",
            "to": "supervisor_context"
          },
          {
            "condition": "tools_executed",
            "to": "count"
          }
        ]
      },
      "count": {
        "id": "count",
        "op": "数据",
        "action": "increment",
        "key": "action_batches",
        "default": 0,
        "delta": 1,
        "output_var": "action_batches",
        "edges": [
          {
            "condition": "default",
            "to": "supervision_due"
          }
        ]
      },
      "supervision_due": {
        "id": "supervision_due",
        "op": "条件",
        "condition": "ctx.action_batches % 4 == 0",
        "edges": [
          {
            "condition": "true",
            "to": "supervisor_context"
          },
          {
            "condition": "false",
            "to": "compact"
          }
        ]
      },
      "supervisor_context": {
        "id": "supervisor_context",
        "op": "上下文",
        "action": "select",
        "source": "$session.messages",
        "last_n": 4,
        "max_chars": 40000,
        "output_var": "supervisor_messages",
        "edges": [
          {
            "condition": "context_ready",
            "to": "supervise"
          }
        ]
      },
      "supervise": {
        "id": "supervise",
        "op": "模型",
        "agent": "supervisor",
        "prompt": "supervise",
        "parse_as": "json_object",
        "json_fallback": {
          "text": "Supervisor output was invalid; continue from direct observations and avoid repeating the last action.",
          "type": "supervision",
          "importance": 5,
          "keywords": [
            "recovery"
          ],
          "evidence": []
        },
        "inputs": {
          "trajectory": "$ctx.supervisor_messages",
          "memory": "$ctx.arc_memory"
        },
        "temperature": 0.15,
        "max_tokens": 1500,
        "outputs": {
          "structured": "supervision"
        },
        "edges": [
          {
            "condition": "has_text",
            "to": "store_supervision"
          },
          {
            "condition": "json_fallback",
            "to": "store_supervision"
          }
        ]
      },
      "store_supervision": {
        "id": "store_supervision",
        "op": "记忆",
        "action": "add_unique",
        "namespace": "arc_agi3_mechanics",
        "memory_type": "supervision",
        "inputs": {
          "value": "$ctx.supervision"
        },
        "dedupe_key": "text",
        "retention": 10,
        "output_var": "stored_supervision",
        "edges": [
          {
            "condition": "default",
            "to": "memory"
          }
        ]
      },
      "result": {
        "id": "result",
        "op": "结束",
        "value": {
          "status": "finished",
          "result": "$node.tools.results",
          "actions": "$ctx.action_batches",
          "memory": "$ctx.arc_memory",
          "trajectory": "$ctx._trajectory"
        },
        "edges": []
      },
      "budget_finish": {
        "id": "budget_finish",
        "op": "结束",
        "value": {
          "status": "budget_exceeded",
          "reason": "$ctx._termination.message",
          "actions": "$ctx.action_batches",
          "trajectory": "$ctx._trajectory"
        },
        "edges": []
      }
    }
  }
}