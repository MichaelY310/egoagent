# Copy to .env.local and fill only the providers you use. Never commit real keys.
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
EGOAGENT_LLM_API_KEY=

# Generic OpenAI-compatible provider settings. DeepSeek example:
# EGOAGENT_LLM_PROVIDER=deepseek
# EGOAGENT_LLM_BASE_URL=https://api.deepseek.com
# EGOAGENT_LLM_MODEL=deepseek-v4-flash
# EGOAGENT_LLM_API_KEY=${DEEPSEEK_API_KEY}
EGOAGENT_LLM_PROVIDER=
EGOAGENT_LLM_BASE_URL=
EGOAGENT_LLM_MODEL=
EGOAGENT_LLM_ENABLE_THINKING=false
EGOAGENT_LLM_MAX_TOKENS=
EGOAGENT_LLM_TEMPERATURE=
EGOAGENT_LLM_TIMEOUT=120
EGOAGENT_LLM_MAX_RETRIES=2
EGOAGENT_LLM_RETRY_BACKOFF=1
EGOAGENT_LLM_STREAM_RESUME=true

# Product defaults remain localhost-only. Do not change this to a LAN address
# without adding authentication and TLS in front of the local API.
EGOAGENT_HOST=127.0.0.1

# Application-local DNS fallback for model-provider HTTPS calls. This never
# changes Windows DNS or the system proxy. "auto" uses normal DNS when healthy
# and otherwise starts a localhost-only CONNECT tunnel with direct UDP DNS.
# EGOAGENT_LLM_APP_DNS_PROXY=auto
# EGOAGENT_LLM_DNS_SERVERS=223.5.5.5,119.29.29.29

# Optional existing HTTP CONNECT proxy. When set, it takes precedence over the
# application-local DNS fallback and is used only by EgoAgent LLM requests.
# EGOAGENT_LLM_HTTPS_PROXY=http://127.0.0.1:7890
